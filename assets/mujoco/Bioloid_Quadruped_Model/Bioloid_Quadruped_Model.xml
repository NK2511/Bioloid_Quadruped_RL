<mujoco model="Bioloid_Quadruped_Model">
    <compiler angle="radian" />
    <option timestep="0.004166666666666667" iterations="50" tolerance="1e-10" />
    
    <asset>
        <mesh name="base_link" file="meshes/base_link.stl" scale="0.001 0.001 0.001" />
        <mesh name="FR_Hip" file="meshes/FR_Hip.stl" scale="0.001 0.001 0.001" />
        <mesh name="FL_Hip" file="meshes/FL_Hip.stl" scale="0.001 0.001 0.001" />
        <mesh name="BR_Hip" file="meshes/BR_Hip.stl" scale="0.001 0.001 0.001" />
